<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SuperDev.Views.MainWindow"
        Width="1000"
        Height="850"
        MinWidth="800"
        MinHeight="700"
        Title="Super Dev"
        Icon="/Assets/app.ico"
        Background="#0B1120">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenu>
                    <NativeMenuItem Header="New Checklist"
                                    Click="NewChecklistMenu_Click"/>
                    <NativeMenuItem Header="Open…"
                                    Click="OpenMenu_Click"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="Save"
                                    Click="SaveMenu_Click"/>
                    <NativeMenuItem Header="Save As…"
                                    Click="SaveAsMenu_Click"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Options">
                <NativeMenu>
                    <NativeMenuItem Header="Add Check"
                                    IsEnabled="False"
                                    Click="AddCheckMenu_Click"/>
                    <NativeMenuItem Header="Save as template"
                                    IsEnabled="False"
                                    Click="SaveAsTemplateMenu_Click"/>
                    <NativeMenuItem Header="Rearrange…"
                                    IsEnabled="False"
                                    Click="RearrangeMenu_Click"/>
                    <NativeMenuItem Header="Copy to…"
                                    IsEnabled="False"
                                    Click="CopyMenu_Click"/>
                    <NativeMenuItem Header="Delete…"
                                    IsEnabled="False"
                                    Click="DeleteChecksMenu_Click"/>
                    <NativeMenuItem Header="Pin Tab"
                                    IsEnabled="False"
                                    Click="PinTabMenu_Click"/>
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Help">
                <NativeMenu>
                    <NativeMenuItem Header="Keyboard Shortcuts"
                                    Click="KeyboardShortcutsMenu_Click"/>
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Styles>

        <!-- ========================================================= -->
        <!-- GLOBAL                                                     -->
        <!-- ========================================================= -->

        <Style Selector="TextBlock">
            <Setter Property="FontFamily"
                    Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Foreground"
                    Value="#F8FAFC"/>
        </Style>
<Style Selector="Border.workspace-tab">
    <Setter Property="MinWidth" Value="64"/>
    <Setter Property="MaxWidth" Value="190"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="Background" Value="#172033"/>
    <Setter Property="BorderBrush" Value="#263449"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
</Style>

<Style Selector="Border.workspace-tab.selected">
    <Setter Property="Background" Value="#172F55"/>
    <Setter Property="BorderBrush" Value="#3B82F6"/>
</Style>

<Style Selector="Border.workspace-tab.dragging">
    <Setter Property="Background" Value="#1E3A5F"/>
    <Setter Property="BorderBrush" Value="#60A5FA"/>
    <Setter Property="ZIndex" Value="2"/>
</Style>

<!-- The tab scroller reserves a row for its bar so it does not cover the tabs.
     These styles keep that bar as a thin thumb, without the arrow buttons. -->
<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar">
    <Setter Property="AllowAutoHide" Value="True"/>
    <Setter Property="Height" Value="4"/>
    <Setter Property="MinHeight" Value="4"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ Grid#Root">
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ Rectangle#TrackRect">
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineUpButton,
                 ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Width" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ Thumb">
    <Setter Property="Height" Value="3"/>
    <Setter Property="MinHeight" Value="3"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="RenderTransform" Value="none"/>
    <Setter Property="Background" Value="#64748B"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ Grid#Root">
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ RepeatButton">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ Thumb">
    <Setter Property="Height" Value="3"/>
    <Setter Property="RenderTransform" Value="none"/>
    <Setter Property="Background" Value="#94A3B8"/>
</Style>

<Style Selector="Button.tab-close">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#94A3B8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style Selector="Button.tab-close:pointerover">
    <Setter Property="Background" Value="#3F1D1D"/>
    <Setter Property="Foreground" Value="#F87171"/>
</Style>

<Style Selector="Button.tab-pin">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinWidth" Value="22"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="#334155"/>
    <Setter Property="BorderBrush" Value="#94A3B8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
</Style>

<Style Selector="Button.tab-pin /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style Selector="Button.tab-pin Shape">
    <Setter Property="Stroke" Value="#F8FAFC"/>
    <Setter Property="Fill" Value="Transparent"/>
</Style>

<Style Selector="Button.tab-pin:pointerover">
    <Setter Property="Background" Value="#475569"/>
    <Setter Property="BorderBrush" Value="#E2E8F0"/>
</Style>

<Style Selector="Button.tab-pin Viewbox.pin-on">
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="Button.tab-pin.pinned">
    <Setter Property="Background" Value="#2563EB"/>
    <Setter Property="BorderBrush" Value="#93C5FD"/>
</Style>

<Style Selector="Button.tab-pin.pinned Viewbox.pin-off">
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="Button.tab-pin.pinned Viewbox.pin-on">
    <Setter Property="IsVisible" Value="True"/>
</Style>

<Style Selector="Button.tab-pin.pinned Shape">
    <Setter Property="Stroke" Value="#FFFFFF"/>
    <Setter Property="Fill" Value="#FFFFFF"/>
</Style>

<Style Selector="Button.tab-pin.pinned:pointerover">
    <Setter Property="Background" Value="#1D4ED8"/>
    <Setter Property="BorderBrush" Value="#FFFFFF"/>
</Style>

<Style Selector="Button.settings-back">
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Background" Value="#172033"/>
    <Setter Property="Foreground" Value="#E2E8F0"/>
    <Setter Property="BorderBrush" Value="#334155"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style Selector="Button.settings-back:pointerover">
    <Setter Property="Background" Value="#1E2A3F"/>
    <Setter Property="BorderBrush" Value="#3B82F6"/>
</Style>

<Style Selector="Menu.title-menu">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#E2E8F0"/>
    <Setter Property="FontSize" Value="13"/>
</Style>

<Style Selector="Menu.title-menu > MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#E2E8F0"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
</Style>

<Style Selector="Menu.title-menu > MenuItem:pointerover">
    <Setter Property="Background" Value="#172033"/>
</Style>

<Style Selector="Menu.title-menu MenuItem">
    <Setter Property="Background" Value="#0F172A"/>
    <Setter Property="Foreground" Value="#E2E8F0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,8"/>
</Style>

<Style Selector="Menu.title-menu MenuItem:pointerover">
    <Setter Property="Background" Value="#1E293B"/>
</Style>

<Style Selector="Menu.title-menu MenuItem:disabled">
    <Setter Property="Foreground" Value="#64748B"/>
</Style>

<Style Selector="Button.new-tab">
<Setter Property="Width" Value="36"/>
<Setter Property="MinWidth" Value="36"/>
<Setter Property="Height" Value="36"/>
<Setter Property="Padding" Value="0"/>
<Setter Property="CornerRadius" Value="18"/>
<Setter Property="HorizontalContentAlignment" Value="Center"/>
<Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Background" Value="#2563EB"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
</Style>

        <!-- ========================================================= -->
        <!-- WORK TITLE INPUT                                           -->
        <!-- ========================================================= -->

<Style Selector="TextBox.work-title">
    <Setter Property="Height" Value="52"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="#111827"/>
    <Setter Property="Foreground" Value="#F8FAFC"/>
    <Setter Property="BorderBrush" Value="#334155"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="PlaceholderForeground" Value="#64748B"/>
</Style>

<Style Selector="TextBox.work-title:focus">
    <Setter Property="BorderBrush" Value="#3B82F6"/>
</Style>

<Style Selector="Button.recent">
    <Setter Property="Height" Value="56"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="#111827"/>
    <Setter Property="BorderBrush" Value="#263449"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,8"/>
</Style>

<Style Selector="Button.recent:pointerover">
    <Setter Property="Background" Value="#1E2A3F"/>
    <Setter Property="BorderBrush" Value="#3B82F6"/>
</Style>

<Style Selector="Button.recent:pressed">
    <Setter Property="Background" Value="#172033"/>
</Style>


        <!-- ========================================================= -->
        <!-- TEMPLATE CARD                                              -->
        <!-- ========================================================= -->

        <Style Selector="Button.template">
            <Setter Property="Width" Value="148"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#263449"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
    </Style>

        <!-- Hover -->
        <Style Selector="Button.template:pointerover">
            <Setter Property="Background" Value="#1E2A3F"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <!-- Pressed -->
        <Style Selector="Button.template:pressed">
            <Setter Property="Background" Value="#263A5A"/>
        </Style>

        <!-- Selected -->
        <Style Selector="Button.template.selected">
            <Setter Property="Background" Value="#172F55"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.template-edit">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,6,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ZIndex" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.template-edit /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.template-edit:pointerover">
            <Setter Property="Background" Value="#263449"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <Style Selector="TextBlock.template-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="120"/>
            <Setter Property="MaxHeight" Value="36"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>


        <!-- ========================================================= -->
        <!-- TEMPLATE ICON                                              -->
        <!-- ========================================================= -->

        <Style Selector="TextBlock.template-icon">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>


        <!-- ========================================================= -->
        <!-- CREATE BUTTON                                               -->
        <!-- ========================================================= -->

<Style Selector="Button.create">
    <Setter Property="MinWidth" Value="150"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="Padding" Value="28,10"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#2563EB"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>

    <Setter Property="HorizontalContentAlignment"
            Value="Center"/>

    <Setter Property="VerticalContentAlignment"
            Value="Center"/>
</Style>

        <Style Selector="Button.create:pointerover">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>

        <Style Selector="Button.create:pressed">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>

        <Style Selector="Button.create.open">
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.create.open:pointerover">
            <Setter Property="Background" Value="#1E2A3F"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <Style Selector="Button.create.open:pressed">
            <Setter Property="Background" Value="#172033"/>
        </Style>

        <Style Selector="Button.bell">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.bell /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.bell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#172033"/>
        </Style>

        <Style Selector="Button.bell:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#172033"/>
        </Style>

        <Style Selector="Button.bell Path">
            <Setter Property="Stroke" Value="#94A3B8"/>
        </Style>

        <Style Selector="Button.bell:pointerover Path">
            <Setter Property="Stroke" Value="#F8FAFC"/>
        </Style>

        <Style Selector="Button.bell.due Path">
            <Setter Property="Stroke" Value="#FBBF24"/>
        </Style>

        <Style Selector="FlyoutPresenter.notify-popup">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style Selector="Button.notify-row /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B"/>
        </Style>

        <Style Selector="Button.notify-dismiss">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-dismiss /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-dismiss:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <Style Selector="Button.notify-clear-all">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-clear-all /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.notify-clear-all:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#93C5FD"/>
        </Style>

        <Style Selector="TextBlock.notify-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style Selector="TextBlock.notify-meta">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </Window.Styles>


    <!-- ============================================================= -->
    <!-- MAIN CONTENT                                                  -->
    <!-- ============================================================= -->

    <Grid RowDefinitions="Auto,Auto,*">

    <Border x:Name="TitleChrome"
            Grid.Row="0"
            Height="40"
            Background="#0B1120"
            BorderBrush="#263449"
            BorderThickness="0,0,0,1"
            Padding="12,0">
        <Grid ColumnDefinitions="Auto,Auto,*">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Image Width="18"
                       Height="18"
                       Source="avares://Super Dev/Assets/app.ico"/>
                <TextBlock Text="Super Dev"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="ReminderBell"
                    Grid.Column="2"
                    Classes="bell"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    ToolTip.Tip="Notifications">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight"
                            FlyoutPresenterClasses="notify-popup"
                            Opened="ReminderBell_Opened"
                            Closed="ReminderBell_Closed">
                        <DockPanel Width="300">
                            <Grid DockPanel.Dock="Top"
                                  ColumnDefinitions="*,Auto"
                                  Margin="8,4,4,6">
                                <TextBlock Text="Notifications"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ClearAllNotificationsButton"
                                        Grid.Column="1"
                                        Classes="notify-clear-all"
                                        Content="Clear all"
                                        IsVisible="False"
                                        Click="ClearAllNotifications_Click"/>
                            </Grid>
                            <ScrollViewer MaxHeight="268"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ReminderList" Spacing="2"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Flyout>
                </Button.Flyout>
                <Panel Width="32" Height="32">
                    <Viewbox Width="16"
                             Height="16"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Path Width="16"
                              Height="17"
                              Stretch="Uniform"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Fill="Transparent"
                              Data="M8,17 A2,2 0 0 0 10,15 H6 A2,2 0 0 0 8,17 M14,11 V6 A6,6 0 1 0 2,6 V11 L0,13 H16 Z"/>
                    </Viewbox>
                    <Ellipse x:Name="ReminderBadge"
                             Width="7"
                             Height="7"
                             Fill="#F87171"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,5,5,0"
                             IsVisible="False"
                             IsHitTestVisible="False"/>
                </Panel>
            </Button>
            <Menu x:Name="WindowMenu"
                  Grid.Column="1"
                  Classes="title-menu"
                  IsVisible="False"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0">
                <MenuItem Header="File">
                    <MenuItem Header="New Checklist"/>
                    <MenuItem Header="Open…"/>
                    <Separator/>
                    <MenuItem x:Name="WindowSaveMenuItem"
                              Header="Save"/>
                    <MenuItem Header="Save As…"/>
                </MenuItem>
                <MenuItem Header="Options">
                    <MenuItem x:Name="WindowAddCheckMenuItem"
                              Header="Add Check"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowSaveTemplateMenuItem"
                              Header="Save as template"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowRearrangeMenuItem"
                              Header="Rearrange…"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowCopyMenuItem"
                              Header="Copy to…"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowDeleteMenuItem"
                              Header="Delete…"
                              IsEnabled="False"/>
                    <MenuItem x:Name="WindowPinMenuItem"
                              Header="Pin Tab"
                              IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="Keyboard Shortcuts"/>
                </MenuItem>
            </Menu>
        </Grid>
    </Border>

    <!-- Tab bar -->
    <Border x:Name="TabBar"
        Grid.Row="1"
        Background="#0B1120"
        Padding="12,8"
        BorderBrush="#263449"
        BorderThickness="0,0,0,1"
        IsVisible="False">

    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="12">

        <ScrollViewer x:Name="TabsScrollViewer"
                      Classes="tabs"
                      Grid.Column="0"
                      ClipToBounds="True"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      AllowAutoHide="False">

            <StackPanel x:Name="TabsPanel"
                        Orientation="Horizontal"
                        Spacing="8"/>
        </ScrollViewer>

        <Button Grid.Column="1"
                Classes="new-tab"
                ToolTip.Tip="New checklist"
                Click="NewTab_Click">
            <Grid Width="14" Height="14">
                <Rectangle Width="14"
                           Height="2"
                           Fill="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Rectangle Width="2"
                           Height="14"
                           Fill="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Button>

    </Grid>
</Border>

    <!-- Active checklist view -->
    <ContentControl x:Name="WorkspaceContent"
                    Grid.Row="2"
                    IsVisible="False"/>

    <!-- Your existing template-selection screen -->
    <ScrollViewer x:Name="HomePanel"
                  Grid.Row="2"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          Margin="50">

        <!-- ========================================================= -->
        <!-- HEADER                                                      -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,20,0,45">

            <TextBlock Text="Super Dev"
                       FontSize="38"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#F8FAFC"/>

            <TextBlock Text="Developer Checklist Assistant"
                       FontSize="17"
                       HorizontalAlignment="Center"
                       Foreground="#94A3B8"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- RECENT CHECKLISTS                                           -->
        <!-- ========================================================= -->

        <StackPanel x:Name="RecentSection"
                    Grid.Row="1"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,0,0,32"
                    IsVisible="False">

            <TextBlock Text="Recent checklists"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"/>

            <Grid x:Name="RecentItems"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="8"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- WORK TITLE                                                  -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="2"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="9"
                    Margin="0,0,0,35">

            <TextBlock Text="Work title"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"/>

            <TextBox x:Name="WorkTitleTextBox"
                     Classes="work-title"
                     Watermark="What are you working on?"
                     WatermarkForeground="#64748B"/>

            <TextBlock Text="Branch name"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"
                       Margin="0,8,0,0"/>

            <TextBox x:Name="BranchNameTextBox"
                     Classes="work-title"
                     PlaceholderText="feature/my-change"/>

            <TextBlock Text="Repository link"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"
                       Margin="0,8,0,0"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <TextBox x:Name="RepositoryTextBox"
                         Classes="work-title"
                         PlaceholderText="https://github.com/org/repo"
                         TextChanged="Repository_TextChanged"/>

                <Button x:Name="OpenRepositoryButton"
                        Grid.Column="1"
                        Content="Open"
                        Classes="create open"
                        Height="52"
                        MinWidth="88"
                        Padding="16,0"
                        IsEnabled="False"
                        Click="OpenRepository_Click"/>

            </Grid>

            <TextBlock Text="PR link"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"
                       Margin="0,8,0,0"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <TextBox x:Name="PullRequestTextBox"
                         Classes="work-title"
                         PlaceholderText="https://github.com/.../pull/1"
                         TextChanged="PullRequest_TextChanged"/>

                <Button x:Name="OpenPullRequestButton"
                        Grid.Column="1"
                        Content="Open"
                        Classes="create open"
                        Height="52"
                        MinWidth="88"
                        Padding="16,0"
                        IsEnabled="False"
                        Click="OpenPullRequest_Click"/>

            </Grid>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- TEMPLATE LABEL                                              -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="3"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="5"
                    Margin="0,0,0,20">

            <TextBlock Text="Choose a workflow"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"/>

            <TextBlock Text="Select the workflow that best matches your work"
                       FontSize="13"
                       Foreground="#64748B"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- TEMPLATES + CREATE                                          -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Center"
                    Spacing="36">

            <!-- TEMPLATE CARDS -->

            <WrapPanel x:Name="TemplateList"
                       HorizontalAlignment="Center"
                       Orientation="Horizontal"/>


            <!-- CREATE -->

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">

                <Button Classes="create open"
                        Content="Open Checklist"
                        Click="Open_Click"/>

                <Button x:Name="CreateButton"
                        Classes="create"
                        Content="Create Checklist"
                        Click="Create_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>
    </ScrollViewer>

    <ScrollViewer x:Name="SettingsPanel"
                  Grid.Row="2"
                  IsVisible="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720"
                    Margin="24,28,24,40"
                    HorizontalAlignment="Center"
                    Spacing="18">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Keyboard Shortcuts"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Back"
                        Classes="settings-back"
                        VerticalAlignment="Center"
                        Click="CloseSettings_Click"/>
            </Grid>
            <TextBlock Text="Shortcuts depend on the focused control. Space and F2 stay with a text field while you are typing, and shortcuts do not run while a dialog is open. Highlighted keys are the ones used on this computer."
                       FontSize="13"
                       Foreground="#94A3B8"
                       TextWrapping="Wrap"/>
            <StackPanel x:Name="ShortcutSections"
                        Spacing="18"/>
        </StackPanel>
    </ScrollViewer>

    <Border x:Name="ToastHost"
            Grid.RowSpan="3"
            IsVisible="False"
            IsHitTestVisible="False"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="24,0,24,28"
            Padding="14,8"
            Background="#1E293B"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="8"
            ZIndex="20">
        <TextBlock x:Name="ToastText"
                   FontSize="13"
                   Foreground="#E2E8F0"/>
    </Border>
</Grid>

</Window>