<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DevGuard.Views.MainWindow"
        Width="1000"
        Height="850"
        MinWidth="800"
        MinHeight="700"
        Title="DevGuard"
        Background="#0B1120">

    <Window.Styles>

        <!-- ========================================================= -->
        <!-- GLOBAL                                                     -->
        <!-- ========================================================= -->

        <Style Selector="TextBlock">
            <Setter Property="FontFamily"
                    Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Foreground"
                    Value="#F8FAFC"/>
        </Style>


        <!-- ========================================================= -->
        <!-- WORK TITLE INPUT                                           -->
        <!-- ========================================================= -->

<Style Selector="TextBox.work-title">
    <Setter Property="Height" Value="52"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="#111827"/>
    <Setter Property="Foreground" Value="#F8FAFC"/>
    <Setter Property="BorderBrush" Value="#334155"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
</Style>

<Style Selector="TextBox.work-title:focus">
    <Setter Property="BorderBrush" Value="#3B82F6"/>
</Style>


        <!-- ========================================================= -->
        <!-- TEMPLATE CARD                                              -->
        <!-- ========================================================= -->

        <Style Selector="Button.template">
            <Setter Property="Width" Value="215"/>
            <Setter Property="Height" Value="145"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#263449"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
    </Style>

        <!-- Hover -->
        <Style Selector="Button.template:pointerover">
            <Setter Property="Background" Value="#1E2A3F"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <!-- Pressed -->
        <Style Selector="Button.template:pressed">
            <Setter Property="Background" Value="#263A5A"/>
        </Style>

        <!-- Selected -->
        <Style Selector="Button.template.selected">
            <Setter Property="Background" Value="#172F55"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>


        <!-- ========================================================= -->
        <!-- TEMPLATE ICON                                              -->
        <!-- ========================================================= -->

        <Style Selector="TextBlock.template-icon">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>


        <!-- ========================================================= -->
        <!-- CREATE BUTTON                                               -->
        <!-- ========================================================= -->

<Style Selector="Button.create">
    <Setter Property="MinWidth" Value="150"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="Padding" Value="28,10"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#2563EB"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>

    <Setter Property="HorizontalContentAlignment"
            Value="Center"/>

    <Setter Property="VerticalContentAlignment"
            Value="Center"/>
</Style>

        <Style Selector="Button.create:pointerover">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>

        <Style Selector="Button.create:pressed">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>

    </Window.Styles>


    <!-- ============================================================= -->
    <!-- MAIN CONTENT                                                  -->
    <!-- ============================================================= -->

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Margin="50">

        <!-- ========================================================= -->
        <!-- HEADER                                                      -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,20,0,45">

            <TextBlock Text="DevGuard"
                       FontSize="38"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#F8FAFC"/>

            <TextBlock Text="Developer Checklist Assistant"
                       FontSize="17"
                       HorizontalAlignment="Center"
                       Foreground="#94A3B8"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- WORK TITLE                                                  -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="1"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="9"
                    Margin="0,0,0,35">

            <TextBlock Text="Work title"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"/>

            <TextBox x:Name="WorkTitleTextBox"
                     Classes="work-title"
                     Watermark="What are you working on?"
                     WatermarkForeground="#64748B"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- TEMPLATE LABEL                                              -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="2"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="5"
                    Margin="0,0,0,20">

            <TextBlock Text="Choose a workflow"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"/>

            <TextBlock Text="Select the workflow that best matches your work"
                       FontSize="13"
                       Foreground="#64748B"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- TEMPLATES + CREATE                                          -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    Spacing="42">

            <!-- TEMPLATE CARDS -->

            <WrapPanel HorizontalAlignment="Center"
                       Orientation="Horizontal">

                <!-- BUG -->
                <Button x:Name="BugButton"
                        Classes="template"
                        Tag="Bug"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🐛"
                                   Classes="template-icon"/>

                        <TextBlock Text="Bug Fix"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- FEATURE -->
                <Button x:Name="FeatureButton"
                        Classes="template"
                        Tag="Feature"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="✨"
                                   Classes="template-icon"/>

                        <TextBlock Text="Feature"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- DEVELOPMENT -->
                <Button x:Name="DevelopmentButton"
                        Classes="template"
                        Tag="Development"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="💻"
                                   Classes="template-icon"/>

                        <TextBlock Text="Development"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- TESTING -->
                <Button x:Name="TestingButton"
                        Classes="template"
                        Tag="Testing"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🧪"
                                   Classes="template-icon"/>

                        <TextBlock Text="Testing"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- PR -->
                <Button x:Name="PullRequestButton"
                        Classes="template"
                        Tag="PullRequest"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🔀"
                                   Classes="template-icon"/>

                        <TextBlock Text="Pull Request"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </WrapPanel>


            <!-- CREATE -->

            <Button x:Name="CreateButton"
                    Classes="create"
                    Content="Create Checklist"
                    HorizontalAlignment="Center"
                    Click="Create_Click"/>

        </StackPanel>

    </Grid>

</Window>