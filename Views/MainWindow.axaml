<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DevGuard.Views.MainWindow"
        Width="1000"
        Height="850"
        MinWidth="800"
        MinHeight="700"
        Title="DevGuard"
        Background="#0B1120">

    <Window.Styles>

        <!-- ========================================================= -->
        <!-- GLOBAL                                                     -->
        <!-- ========================================================= -->

        <Style Selector="TextBlock">
            <Setter Property="FontFamily"
                    Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Foreground"
                    Value="#F8FAFC"/>
        </Style>
<Style Selector="Border.workspace-tab">
    <Setter Property="MinWidth" Value="64"/>
    <Setter Property="MaxWidth" Value="190"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="Background" Value="#172033"/>
    <Setter Property="BorderBrush" Value="#263449"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
</Style>

<Style Selector="Border.workspace-tab.selected">
    <Setter Property="Background" Value="#172F55"/>
    <Setter Property="BorderBrush" Value="#3B82F6"/>
</Style>

<!-- The tab scroller reserves a row for its bar so it does not cover the tabs.
     These styles keep that bar as a thin thumb, without the arrow buttons. -->
<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar">
    <Setter Property="AllowAutoHide" Value="True"/>
    <Setter Property="Height" Value="4"/>
    <Setter Property="MinHeight" Value="4"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ Grid#Root">
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ Rectangle#TrackRect">
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineUpButton,
                 ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="Width" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar /template/ Thumb">
    <Setter Property="Height" Value="3"/>
    <Setter Property="MinHeight" Value="3"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="RenderTransform" Value="none"/>
    <Setter Property="Background" Value="#64748B"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ Grid#Root">
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ RepeatButton">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="IsVisible" Value="False"/>
</Style>

<Style Selector="ScrollViewer.tabs /template/ ScrollBar#PART_HorizontalScrollBar[IsExpanded=true] /template/ Thumb">
    <Setter Property="Height" Value="3"/>
    <Setter Property="RenderTransform" Value="none"/>
    <Setter Property="Background" Value="#94A3B8"/>
</Style>

<Style Selector="Button.tab-close">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#94A3B8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style Selector="Button.tab-close:pointerover">
    <Setter Property="Background" Value="#3F1D1D"/>
    <Setter Property="Foreground" Value="#F87171"/>
</Style>

<Style Selector="Button.new-tab">
<Setter Property="Width" Value="36"/>
<Setter Property="MinWidth" Value="36"/>
<Setter Property="Height" Value="36"/>
<Setter Property="Padding" Value="0"/>
<Setter Property="CornerRadius" Value="18"/>
<Setter Property="HorizontalContentAlignment" Value="Center"/>
<Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Background" Value="#2563EB"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
</Style>

        <!-- ========================================================= -->
        <!-- WORK TITLE INPUT                                           -->
        <!-- ========================================================= -->

<Style Selector="TextBox.work-title">
    <Setter Property="Height" Value="52"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="#111827"/>
    <Setter Property="Foreground" Value="#F8FAFC"/>
    <Setter Property="BorderBrush" Value="#334155"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
</Style>

<Style Selector="TextBox.work-title:focus">
    <Setter Property="BorderBrush" Value="#3B82F6"/>
</Style>


        <!-- ========================================================= -->
        <!-- TEMPLATE CARD                                              -->
        <!-- ========================================================= -->

        <Style Selector="Button.template">
            <Setter Property="Width" Value="215"/>
            <Setter Property="Height" Value="145"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#263449"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
    </Style>

        <!-- Hover -->
        <Style Selector="Button.template:pointerover">
            <Setter Property="Background" Value="#1E2A3F"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <!-- Pressed -->
        <Style Selector="Button.template:pressed">
            <Setter Property="Background" Value="#263A5A"/>
        </Style>

        <!-- Selected -->
        <Style Selector="Button.template.selected">
            <Setter Property="Background" Value="#172F55"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>


        <!-- ========================================================= -->
        <!-- TEMPLATE ICON                                              -->
        <!-- ========================================================= -->

        <Style Selector="TextBlock.template-icon">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>


        <!-- ========================================================= -->
        <!-- CREATE BUTTON                                               -->
        <!-- ========================================================= -->

<Style Selector="Button.create">
    <Setter Property="MinWidth" Value="150"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="Padding" Value="28,10"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#2563EB"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="10"/>

    <Setter Property="HorizontalContentAlignment"
            Value="Center"/>

    <Setter Property="VerticalContentAlignment"
            Value="Center"/>
</Style>

        <Style Selector="Button.create:pointerover">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>

        <Style Selector="Button.create:pressed">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>

    </Window.Styles>


    <!-- ============================================================= -->
    <!-- MAIN CONTENT                                                  -->
    <!-- ============================================================= -->

    <Grid RowDefinitions="Auto,*">

    <!-- Tab bar -->
    <Border x:Name="TabBar"
        Grid.Row="0"
        Background="#0B1120"
        Padding="12,8"
        BorderBrush="#263449"
        BorderThickness="0,0,0,1"
        IsVisible="False">

    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="12">

        <ScrollViewer x:Name="TabsScrollViewer"
                      Classes="tabs"
                      Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      AllowAutoHide="False">

            <StackPanel x:Name="TabsPanel"
                        Orientation="Horizontal"
                        Spacing="8"/>
        </ScrollViewer>

        <Button Grid.Column="1"
                Classes="new-tab"
                ToolTip.Tip="New checklist"
                Click="NewTab_Click">
            <Grid Width="14" Height="14">
                <Rectangle Width="14"
                           Height="2"
                           Fill="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Rectangle Width="2"
                           Height="14"
                           Fill="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Button>

    </Grid>
</Border>

    <!-- Active checklist view -->
    <ContentControl x:Name="WorkspaceContent"
                    Grid.Row="1"
                    IsVisible="False"/>

    <!-- Your existing template-selection screen -->
    <Grid x:Name="HomePanel"
          Grid.Row="1"
          RowDefinitions="Auto,Auto,Auto,*"
          Margin="50">

        <!-- ========================================================= -->
        <!-- HEADER                                                      -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="0,20,0,45">

            <TextBlock Text="DevGuard"
                       FontSize="38"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#F8FAFC"/>

            <TextBlock Text="Developer Checklist Assistant"
                       FontSize="17"
                       HorizontalAlignment="Center"
                       Foreground="#94A3B8"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- WORK TITLE                                                  -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="1"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="9"
                    Margin="0,0,0,35">

            <TextBlock Text="Work title"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"/>

            <TextBox x:Name="WorkTitleTextBox"
                     Classes="work-title"
                     Watermark="What are you working on?"
                     WatermarkForeground="#64748B"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- TEMPLATE LABEL                                              -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="2"
                    Width="720"
                    HorizontalAlignment="Center"
                    Spacing="5"
                    Margin="0,0,0,20">

            <TextBlock Text="Choose a workflow"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#CBD5E1"/>

            <TextBlock Text="Select the workflow that best matches your work"
                       FontSize="13"
                       Foreground="#64748B"/>

        </StackPanel>


        <!-- ========================================================= -->
        <!-- TEMPLATES + CREATE                                          -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    Spacing="42">

            <!-- TEMPLATE CARDS -->

            <WrapPanel HorizontalAlignment="Center"
                       Orientation="Horizontal">

                <!-- BUG -->
                <Button x:Name="BugButton"
                        Classes="template"
                        Tag="Bug"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🐛"
                                   Classes="template-icon"/>

                        <TextBlock Text="Bug Fix"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- FEATURE -->
                <Button x:Name="FeatureButton"
                        Classes="template"
                        Tag="Feature"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="✨"
                                   Classes="template-icon"/>

                        <TextBlock Text="Feature"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- DEVELOPMENT -->
                <Button x:Name="DevelopmentButton"
                        Classes="template"
                        Tag="Development"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="💻"
                                   Classes="template-icon"/>

                        <TextBlock Text="Development"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- TESTING -->
                <Button x:Name="TestingButton"
                        Classes="template"
                        Tag="Testing"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🧪"
                                   Classes="template-icon"/>

                        <TextBlock Text="Testing"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- PR -->
                <Button x:Name="PullRequestButton"
                        Classes="template"
                        Tag="PullRequest"
                        Click="WorkflowButton_Click">

                    <StackPanel Spacing="10"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🔀"
                                   Classes="template-icon"/>

                        <TextBlock Text="Pull Request"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>

<!-- BLANK -->
                <Button x:Name="BlankButton"
        Classes="template"
        Tag="Blank"
        Click="WorkflowButton_Click">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
        <TextBlock Text="＋"
                   Classes="template-icon"/>
        <TextBlock Text="Blank Checklist"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"/>
    </StackPanel>
</Button>

            </WrapPanel>


            <!-- CREATE -->

            <Button x:Name="CreateButton"
                    Classes="create"
                    Content="Create Checklist"
                    HorizontalAlignment="Center"
                    Click="Create_Click"/>

        </StackPanel>

    </Grid>
</Grid>

</Window>