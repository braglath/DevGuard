<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SuperDev.Views.ReorderChecksWindow"
        Width="560"
        Height="640"
        MinWidth="460"
        MinHeight="420"
        CanResize="True"
        Title="Rearrange checks"
        Icon="/Assets/app.ico"
        Background="#0B1120"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <Style Selector="TextBlock.dialog-title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.dialog-message">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="Border.reorder-row">
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#263449"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="SizeAll"/>
        </Style>

        <Style Selector="Border.reorder-row:pointerover">
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <Style Selector="Border.reorder-row.dragging">
            <Setter Property="Background" Value="#172F55"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="TextBlock.reorder-grip">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style Selector="TextBlock.reorder-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="TextBlock.reorder-meta">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style Selector="Button.dialog-button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.dialog-button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#172033"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#1E2A3F"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>
    </Window.Styles>

    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Classes="dialog-title"
                   Text="Rearrange checks"/>

        <TextBlock Grid.Row="1"
                   Classes="dialog-message"
                   Margin="0,10,0,16"
                   Text="Drag a check to move it. The checklist uses this order."/>

        <Border Grid.Row="2"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,12,12,4">
            <ScrollViewer x:Name="OrderScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="OrderList"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Classes="dialog-button secondary"
                    Content="Cancel"
                    Click="Cancel_Click"/>
            <Button Classes="dialog-button primary"
                    Content="Done"
                    IsDefault="True"
                    Click="Done_Click"/>
        </StackPanel>
    </Grid>
</Window>
