<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>SuperDev</RootNamespace>
    <AssemblyName>Super Dev</AssemblyName>
    <Product>Super Dev</Product>
    <AssemblyTitle>Super Dev</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Platform\notify.m" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <Target Name="CompileMacNotifier"
          BeforeTargets="CoreCompile"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx-')))"
          Inputs="Platform/notify.m"
          Outputs="$(OutputPath)libSuperDevNotify.dylib">
    <PropertyGroup>
      <MacNotifierArch Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">arm64</MacNotifierArch>
      <MacNotifierArch Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64</MacNotifierArch>
      <MacNotifierArch Condition="'$(MacNotifierArch)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'Arm64'">arm64</MacNotifierArch>
      <MacNotifierArch Condition="'$(MacNotifierArch)' == ''">x86_64</MacNotifierArch>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)" />
    <Exec Command="clang -arch $(MacNotifierArch) -dynamiclib -fobjc-arc -O2 -Wno-deprecated-declarations -o &quot;$(OutputPath)libSuperDevNotify.dylib&quot; &quot;Platform/notify.m&quot; -framework Foundation -framework AppKit -framework UserNotifications" />
  </Target>

  <Target Name="AddMacNotifierToPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and $(RuntimeIdentifier.StartsWith('osx-'))">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutputPath)libSuperDevNotify.dylib">
        <RelativePath>libSuperDevNotify.dylib</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
